#!/bin/bash

set -e

# bash script to mute video file
# usage:
#   mute-video filename

file=$1

dir=$(dirname $file)
filename=$(basename -- "$file")
extension="${filename##*.}"
filename="${filename%.*}"
muted_filename="$dir/$filename-muted.$extension"

ffmpeg -i "$file" -vcodec copy -an "$muted_filename"
mv "$muted_filename" "$file"

echo "Muted file $file"


#!/usr/bin/env python3

import os
import sys
import shutil
import subprocess
import datetime
import re
import time
import mimetypes
from pathlib import Path
from enum import Enum


HOME = str(Path.home())
SCREENSHOTS_DIR = os.path.join(HOME, "Pictures/screenshots")
TARGET_DIR = os.path.join(HOME, "Pictures/game_social_media/neon_blitz")
EXTENSIONS = ['.png', '.jpg', '.jpeg', '.gif', '.mp4', '.mov', '.webm']
TWEETS_FILE_NAME = "tweets.md"
TWEETS_TEMPLATE="""
## {file_name}

![{file_name}]({file_path})

**Prompt: {prompt}**

{tweets}
"""
ALT_LLM_PROMPT="""
You are the main developer for my indie game dev company, Binary Sunrise. Currently you are the sole developer and are working on a game called Neon Blitz, an arena shooter rogue-like with a sci-fi aesthetic.

You are going to write tweets based on a description / piece of inspiration for an image or video that is going to be included with the tweet. This piece of media will be of something you recently worked on, usually of the game. Respond with 6 possible tweets based on this description that can be used to promote the game / company.

Within these 6 tweets you may use between the following hashtags depending on the content:
#gamedev - for general tweets about game development
#indiedev - fairly generic hashtag, but can be used to emphasize when something impressive was accomplished by a lone developer
#godotengine - when the content is either technical or impressive. If the tweet describes something specific with programming and development then this is likely a good tag as it's specific to godot developers. When the media is impressive, it can help show what's possible in the engine
#indiegamedev - provides the most coverage out of any single tag for game development. Should use often
#screenshotsaturday - for a picture that does a really great job of representing what the game is about to someone new

Other hashtags are okay as well but only if they fit the tweet. Never use more than 2 hashtags in any tweet.

Here are some example good tweets by other developers.
------------------------------
---
Sea Sniffers desert sailing vibes #gamedev #pixelart
CRT filter will be included in the options of the final release ✨
---
so the boat in my game Spilled! actually has a propeller that spins when you drive :)

it's a small detail but I like small details :D
game is out now btw!!!!!
---
All the plant textures you see in my game come from photos I took myself !! 🌿🌾🪻

I made a herbarium, and for the toads, it's my father's hand🖐️🐸
---
Check out this 3d fish book. It's not actually 3d, but I'm pretty pleased with the page flip effect :p
---
Dear lord, RichTextLabel is broken yet again (still) #GodotEngine
---
I added remote call functionality to the dialog system! #screenshotsaturday

Character portraits are automatically cropped and get a transmission distortion. Speech audio even goes through a high-pass filter for some extra polish ✨
---
I spent some time improving on the mesh warp animations for the fish. I'm very happy with the improvement, they look so much more alive! #gamedev

Fish will now also disperse when Momi moves towards them. ✨

Now I'm sick of this stupid test level. I'm gonna make some art!
---
new art setup! Also, a new w.i.p. :)
---
------------------------------

Imitate their casual tone and relaxed style.
Focus on sounding like a developer sharing their work, not a marketing team trying to sell something.
Think less "hype" and more like sharing a small update or observation about the development process.
Occasionally use lowercase for a more relaxed feel, and try to incorporate text-based emojis like ":)", ":p", ":D", "D:", ":/", ":o", ";-;", ">:]" ">:[" where appropriate to match the casual tone of the examples.
**Aim for a tone that is understated and even slightly self-deprecating or humorous at times.**
**Avoid overly positive or exclamatory language unless it's mimicking the specific tone of one of the examples.**

Here is the description of the media / inspiration for the tweet: "%s"

Respond only with the 6 tweets and nothing else.
"""


class MediaType(Enum):
    Image = 1
    Video = 2


class Media:
    type = MediaType.Image
    description = None
    should_delete_file = False

    current_file_path = None

    orig_file_path = None
    orig_file_name = None
    orig_file_extension = None

    dest_dir = None
    dest_file_name = None
    dest_file_path = None

    
    def __init__(self, file_path):
        self.orig_file_path = file_path
        self.orig_file_name = os.path.basename(file_path)
        _, self.orig_file_extension = os.path.splitext(self.orig_file_path)
        self.current_file_path = file_path


    def get_preview_file(self):
        return self.orig_file_path


    def prompt(self):
        self.preview()

        print(f"Enter new name for this {self.type.name.lower()} (without extension)")
        print("Press Enter to keep original name")
        print("Enter 'r' or 'remove' to delete this file")
        new_name = input("> ")

        if new_name in ['r', 'remove']:
            print(f"Marking file for removal: {self.orig_file_path}")
            self.should_delete_file = True
            return

        if not new_name:
            new_name = self.orig_file_name

        self.dest_file_name = new_name

        print("Enter a description for this file")
        self.description = input("> ")


    def preview(self):
        preview_file_path = self.get_preview_file()
        subprocess.run(['kitty', '+kitten', 'icat', preview_file_path])


    def move_to_new_location(self):
        self.dest_file_path = os.path.join(self.dest_dir, f"{self.dest_file_name}{self.orig_file_extension}")
        #shutil.move(self.orig_file_path, self.dest_file_path)
        shutil.copy(self.orig_file_path, self.dest_file_path)
        self.current_file_path = self.dest_file_path


    def delete(self):
        os.remove(self.current_file_path)


    def prompt_llm(self):
        print(f"Prompting LLM for {self.dest_file_name}...")
        completed_process = subprocess.run(
            ['ollama', 'run', 'gemma3:12b', ALT_LLM_PROMPT % (self.description)],
            capture_output=True,
            text=True,
        )
        output = completed_process.stdout

        tweets_file_path = os.path.join(self.dest_dir, TWEETS_FILE_NAME)
        with open(tweets_file_path, "a") as f:
            f.write(TWEETS_TEMPLATE.format(
                file_name=self.dest_file_name,
                file_path=self.dest_file_path,
                prompt=self.description,
                tweets=output,
            ))


    def execute(self):
        if self.should_delete_file:
            self.delete()
            return

        self.move_to_new_location()
        if self.description:
            self.prompt_llm()



class VideoMedia(Media):
    temp_preview_image = None
    should_mute = False
    should_make_gif = False

    def __init__(self, file_path):
        super().__init__(file_path)
        self.type = MediaType.Video


    def get_preview_file(self):
        """Create temporary preview frame from video"""
        safe_name = re.sub(r'[^a-zA-Z0-9]', '_', os.path.basename(self.current_file_path))
        self.temp_preview_image = f"/tmp/preview_{safe_name}.jpg"
        
        try:
            # Extract a frame
            subprocess.run(['ffmpeg', '-hide_banner', '-loglevel', 'error', 
                           '-i', self.current_file_path, '-ss', '00:00:01', '-vframes', '1', self.temp_preview_image], 
                           check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            
            # Resize frame
            subprocess.run(['sips', '-Z', '1080', self.temp_preview_image], 
                          check=True, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            
            return self.temp_preview_image
        except subprocess.SubprocessError as e:
            print(f"Error creating preview: {e}")
            return None


    def prompt(self):
        super().prompt()
        # Check if file should be muted
        mute = input("Mute this video? (Y/n): ")
        self.should_mute = not mute or mute.lower() == 'y'
        
        # Check if GIF should be created
        gif = input("Create a GIF from this video? (Y/n): ")
        self.should_make_gif = not gif or gif.lower() == 'y'


    def preview(self):
        super().preview()
        if self.temp_preview_image and os.path.exists(self.temp_preview_image):
            os.remove(self.temp_preview_image)
            self.temp_preview_image = None


    def optimize(self):
        subprocess.run(['make-web-video', self.current_file_path], check=True)
        if self.orig_file_extension == ".mov":
            # Delete wav file and only keep optimized file
            self.delete()
            self.current_file_path = os.path.join(self.dest_dir, f"{self.dest_file_name}.mp4")


    def mute(self):
        subprocess.run(['mute-video', self.current_file_path], check=True)


    def make_gif(self):
        subprocess.run(['make-gif', self.current_file_path], check=True)


    def execute(self):
        super().execute()

        if self.should_delete_file:
            return

        self.optimize()

        if self.should_mute:
            self.mute()
        if self.should_make_gif:
            self.make_gif()


def get_week_folder():
    """Get the current week folder path"""
    now = datetime.datetime.now()
    month = now.strftime("%B")
    year_week = now.strftime("%V")  # ISO week number
    return os.path.join(month, f"W{year_week}")


def get_dest_dir():
    week_folder = get_week_folder()
    return os.path.join(TARGET_DIR, week_folder)


def create_media(file_path):
    """Detect file type (image, video, or other)"""
    mime_type, _ = mimetypes.guess_type(file_path)

    media = None
    
    if mime_type and mime_type.startswith('image/'):
        media = Media(file_path)
    elif mime_type and mime_type.startswith('video/'):
        media = VideoMedia(file_path)

    if media:
        media.dest_dir = get_dest_dir()
    
    return media


def find_recent_media_files():
    """Find media files modified within the last week"""
    files = []
    now = time.time()
    week_ago = now - (7 * 24 * 60 * 60)
    
    for root, _, filenames in os.walk(SCREENSHOTS_DIR):
        for filename in filenames:
            if any(filename.lower().endswith(ext) for ext in EXTENSIONS):
                file_path = os.path.join(root, filename)
                if os.path.getmtime(file_path) > week_ago:
                    files.append(file_path)
    
    return files


def summarize_changes(media_files):
    moved_count = 0
    optimize_count = 0
    delete_count = 0
    mute_count = 0
    gif_count = 0

    for media in media_files:
        if media.should_delete_file:
            delete_count += 1
            continue

        moved_count += 1
        if media.type == MediaType.Video:
            optimize_count += 1

            if media.should_mute:
                mute_count += 1
            if media.should_make_gif:
                gif_count += 1


    print("The following operations will be performed:")
    print(f"- {moved_count} files will be moved to {get_dest_dir()}")
    print(f"- {mute_count} files will be deleted")
    print(f"- {optimize_count} videos will be optimized")
    print(f"- {mute_count} videos will be muted")
    print(f"- {gif_count} gifs will be created from videos")


def process_files(file_paths):
    dest_dir = get_dest_dir()
    
    # Create destination directory if it doesn't exist
    os.makedirs(dest_dir, exist_ok=True)

    print(f"Files will be organized into: {dest_dir}")
    print("-----------------------------------")

    media_files = []
    for file_path in file_paths:
        media = create_media(file_path)
        if media:
            media_files.append(media)

    for media in media_files:
        media.prompt()

    # Confirm operations
    summarize_changes(media_files)
    confirm = input("Proceed with these operations? (Y/n): ")
    if confirm and confirm.lower() != 'y':
        print("Processing cancelled")
        return

    for media in media_files:
        media.execute()

    print("All operations completed!")


def prompt_open_dir():
    dest_dir = get_dest_dir()

    open_dir = input(f"Open {dest_dir} (Y/n): ")
    if not open_dir or open_dir.lower() == 'y':
       subprocess.run(['open', dest_dir])


def main():
    """Main script execution"""
    print("Media Organization and Processing Script")
    print("========================================")
    
    # Find media files
    files = find_recent_media_files()
    
    if not files:
        print(f"No media files found in {SCREENSHOTS_DIR} that were modified within the last week.")
        prompt_open_dir()
        return 1
    
    print(f"Found {len(files)} media files modified within the last week.")
    process_files(files)
    prompt_open_dir()

    return 0


if __name__ == "__main__":
    sys.exit(main())
